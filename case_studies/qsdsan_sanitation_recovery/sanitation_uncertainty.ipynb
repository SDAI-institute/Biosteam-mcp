   "source": [
    "# Case study â€” Sanitation & nutrient recovery under uncertainty (QSDsan)\n",
    "\n",
    "A resource-recovery sanitation step treats municipal wastewater and recovers N and P.\n",
    "Real recovery efficiencies and influent loads are *uncertain*, so we wrap the system\n",
    "in a `Model` and run Monte Carlo to get **distributions** of recovered phosphorus and\n",
    "effluent quality â€” the deliverable a sanitation designer actually reports."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "3dfafd47",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-07-12T12:05:43.463366Z",
     "iopub.status.busy": "2026-07-12T12:05:43.461995Z",
     "iopub.status.idle": "2026-07-12T12:06:01.011956Z",
     "shell.execute_reply": "2026-07-12T12:06:01.010286Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "QSDsan 1.4.3\n"
     ]
    }
   ],
   "source": [
    "import warnings\n",
    "warnings.filterwarnings(\"ignore\")\n",
    "\n",
    "import numpy as np\n",
    "import chaospy as cp\n",
    "import qsdsan as qs\n",
    "import biosteam as bst\n",
    "\n",
    "cmps = qs.Components.load_default()\n",
    "qs.set_thermo(cmps)\n",
    "print(\"QSDsan\", qs.__version__)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "729b41dd",
   "metadata": {},
   "source": [
    "## System: influent + a nutrient-recovery SanUnit"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "ec137132",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-07-12T12:06:01.019327Z",
     "iopub.status.busy": "2026-07-12T12:06:01.018716Z",
     "iopub.status.idle": "2026-07-12T12:06:01.073063Z",
     "shell.execute_reply": "2026-07-12T12:06:01.072458Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "baseline P recovered = 6.40 kg/hr\n"
     ]
    }
   ],
   "source": [
    "inf = qs.WasteStream(\"influent\")\n",
    "inf.set_flow_by_concentration(\n",
    "    flow_tot=1000,\n",
    "    concentrations={\"S_F\": 200, \"X_B_Subst\": 150, \"S_NH4\": 40, \"S_PO4\": 8},\n",
    "    units=(\"m3/hr\", \"mg/L\"),\n",
    ")\n",
    "\n",
    "class NutrientRecovery(qs.SanUnit):\n",
    "    _N_ins = 1\n",
    "    _N_outs = 2\n",
    "    def __init__(self, ID=\"\", ins=None, outs=(), thermo=None,\n",
    "                 init_with=\"WasteStream\", *, N_recovery=0.6, P_recovery=0.8):\n",
    "        super().__init__(ID, ins, outs, thermo, init_with=init_with)\n",
    "        self.N_recovery = N_recovery\n",
    "        self.P_recovery = P_recovery\n",
    "    def _run(self):\n",
    "        influent = self.ins[0]\n",
    "        effluent, recovered = self.outs\n",
    "        effluent.copy_like(influent)\n",
    "        recovered.empty()\n",
    "        for cmp, frac in ((\"S_NH4\", self.N_recovery), (\"S_PO4\", self.P_recovery)):\n",
    "            moved = influent.imass[cmp] * frac\n",
    "            effluent.imass[cmp] -= moved\n",
    "            recovered.imass[cmp] += moved\n",
    "\n",
    "U1 = NutrientRecovery(\"U1\", ins=inf, outs=(\"effluent\", \"recovered\"))\n",
    "sys = qs.System(\"san_sys\", path=[U1])\n",
    "sys.simulate()\n",
    "print(f\"baseline P recovered = {U1.outs[1].imass['S_PO4']:.2f} kg/hr\")"
   ]
  },
