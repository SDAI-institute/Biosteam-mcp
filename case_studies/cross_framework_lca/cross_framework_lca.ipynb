   "id": "5ed4c4b7",
   "metadata": {},
   "source": [
    "## 1. A foreground process (fermentation â†’ concentration)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "03593ec7",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-07-12T12:07:48.565443Z",
     "iopub.status.busy": "2026-07-12T12:07:48.564888Z",
     "iopub.status.idle": "2026-07-12T12:07:49.369450Z",
     "shell.execute_reply": "2026-07-12T12:07:49.368445Z"
    }
   },
   "outputs": [],
   "source": [
    "from thermosteam.reaction import Reaction\n",
    "\n",
    "feed = bst.Stream(\"glucose_feed\", Glucose=100, Water=900, units=\"kmol/hr\")\n",
    "\n",
    "class Fermenter(bst.Unit):\n",
    "    _N_ins = 1; _N_outs = 1\n",
    "    def __init__(self, ID=\"\", ins=None, outs=(), thermo=None, *, X=1.0):\n",
    "        super().__init__(ID, ins, outs, thermo)\n",
    "        self.reaction = Reaction(\"Glucose -> 2 Ethanol + 2 CO2\", reactant=\"Glucose\", X=X)\n",
    "    def _run(self):\n",
    "        out = self.outs[0]; out.copy_like(self.ins[0]); self.reaction(out); out.T = 305.15\n",
    "\n",
    "R1 = Fermenter(\"R1\", ins=feed, outs=\"broth\")\n",
    "P1 = bst.Pump(\"P1\", ins=R1 - 0, outs=\"pumped\", P=3e5)\n",
    "F1 = bst.Flash(\"F1\", ins=P1 - 0, outs=(\"vapor\", \"beer\"), V=0.3, P=101325)\n",
    "sys = bst.System.from_units(\"fg_sys\", units=[R1, P1, F1])\n",
    "sys.simulate()\n",
    "sys.operating_hours = 24 * 330"
   ]
  },
