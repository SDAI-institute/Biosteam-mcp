   "source": [
    "import warnings\n",
    "warnings.filterwarnings(\"ignore\")\n",
    "\n",
    "import numpy as np\n",
    "from biorefineries import cornstover as cs\n",
    "\n",
    "cs.load()\n",
    "sys = cs.cornstover_sys\n",
    "tea = cs.cornstover_tea\n",
    "ethanol = cs.ethanol\n",
    "print(\"units in system:\", len(sys.units))"
   ]
  },
  {
