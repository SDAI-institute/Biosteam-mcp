    }
   ],
   "source": [
    "import warnings\n",
    "warnings.filterwarnings(\"ignore\")\n",
    "\n",
    "import biosteam as bst\n",
    "import thermosteam as tmo\n",
    "\n",
    "print(\"BioSTEAM\", bst.__version__, \"| thermosteam\", tmo.__version__)"
   ]
  },
