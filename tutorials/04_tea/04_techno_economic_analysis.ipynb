   "source": [
    "import warnings\n",
    "warnings.filterwarnings(\"ignore\")\n",
    "\n",
    "import numpy as np\n",
    "import biosteam as bst\n",
    "\n",
    "bst.main_flowsheet.clear()\n",
    "bst.settings.set_thermo([\"Water\", \"Ethanol\"])\n",
    "print(\"BioSTEAM\", bst.__version__)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "09955a1c",
   "metadata": {},
   "source": [
    "## 1. A conventional TEA\n",
    "\n",
    "`bst.TEA` handles depreciation, taxes, working capital, and discounting. The only\n",
    "method you *must* provide is `_FOC` (fixed operating cost) â€” here labor plus\n",
    "capital-linked charges. Defaults for `_DPI/_TDC/_FCI` pass installed cost through."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "21af5781",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-07-12T01:17:13.268287Z",
     "iopub.status.busy": "2026-07-12T01:17:13.268287Z",
     "iopub.status.idle": "2026-07-12T01:17:13.276558Z",
     "shell.execute_reply": "2026-07-12T01:17:13.276012Z"
    }
   },
   "outputs": [],
   "source": [
    "class ConventionalTEA(bst.TEA):\n",
    "    def __init__(self, system, IRR=0.10, duration=(2020, 2040),\n",
    "                 depreciation=\"MACRS7\", income_tax=0.21, operating_days=330,\n",
    "                 lang_factor=3.0, construction_schedule=(0.4, 0.6),\n",
    "                 WC_over_FCI=0.05, labor_cost=2e6, fringe_benefits=0.4,\n",
    "                 property_tax=0.001, property_insurance=0.005,\n",
    "                 maintenance=0.01, administration=0.005):\n",
    "        super().__init__(system, IRR, duration, depreciation, income_tax,\n",
    "                         operating_days, lang_factor, construction_schedule,\n",
    "                         startup_months=0, startup_FOCfrac=0, startup_VOCfrac=0,\n",
    "                         startup_salesfrac=0, WC_over_FCI=WC_over_FCI,\n",
    "                         finance_interest=0, finance_years=0, finance_fraction=0)\n",
    "        self.labor_cost = labor_cost\n",
    "        self.fringe_benefits = fringe_benefits\n",
    "        self.property_tax = property_tax\n",
    "        self.property_insurance = property_insurance\n",
    "        self.maintenance = maintenance\n",
    "        self.administration = administration\n",
    "\n",
    "    def _FOC(self, FCI):\n",
    "        return (FCI * (self.property_tax + self.property_insurance\n",
    "                       + self.maintenance + self.administration)\n",
    "                + self.labor_cost * (1 + self.fringe_benefits))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "76390ded",
   "metadata": {},
   "source": [
    "## 2. A small costed process\n",
    "\n",
    "Heat a feed, flash off an ethanol-rich vapor, pump the bottoms. Streams carry a\n",
    "`price`, so the TEA sees feedstock cost and product revenue."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "17a38b9e",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-07-12T01:17:13.280225Z",
     "iopub.status.busy": "2026-07-12T01:17:13.280225Z",
     "iopub.status.idle": "2026-07-12T01:17:13.705287Z",
     "shell.execute_reply": "2026-07-12T01:17:13.705287Z"
    }
   },
   "outputs": [],
   "source": [
    "feed = bst.Stream(\"feed\", Water=1000, Ethanol=500, units=\"kmol/hr\", T=298.15, price=0.10)\n",
    "H1 = bst.HXutility(\"H1\", ins=feed, outs=\"hot\", T=360)\n",
    "F1 = bst.Flash(\"F1\", ins=H1 - 0, outs=(\"vapor\", \"liquid\"), V=0.5, P=101325)\n",
    "P1 = bst.Pump(\"P1\", ins=F1 - 1, outs=\"bottoms\")\n",
    "product = F1.outs[0]\n",
    "product.price = 0.80          # $/kg ethanol-rich vapor product\n",
    "\n",
    "sys = bst.System.from_units(\"tea_sys\", units=[H1, F1, P1])\n",
    "sys.simulate()"
   ]
  },
