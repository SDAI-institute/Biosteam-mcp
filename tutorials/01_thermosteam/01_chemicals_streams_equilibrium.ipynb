     "text": [
      "Water      MW= 18.015  Tb= 373.12 K\n",
      "Ethanol    MW= 46.068  Tb= 351.57 K\n",
      "Glycerol   MW= 92.094  Tb= 562.15 K\n"
     ]
    }
   ],
   "source": [
    "chems = tmo.Chemicals([\"Water\", \"Ethanol\", \"Glycerol\"])\n",
