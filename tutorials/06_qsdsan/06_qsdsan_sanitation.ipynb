     "iopub.status.idle": "2026-07-12T11:50:37.987694Z",
     "shell.execute_reply": "2026-07-12T11:50:37.985744Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "QSDsan 1.4.3 | loaded 56 components\n",
      "available SanUnit models: 113\n"
     ]
    }
   ],
   "source": [
    "import warnings\n",
    "warnings.filterwarnings(\"ignore\")\n",
    "\n",
    "import qsdsan as qs\n",
    "import qsdsan.sanunits as su\n",
    "\n",
    "cmps = qs.Components.load_default()\n",
    "qs.set_thermo(cmps)\n",
    "print(\"QSDsan\", qs.__version__, \"| loaded\", len(cmps), \"components\")\n",
    "print(\"available SanUnit models:\", len([n for n in dir(su) if n[0].isupper()]))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "9670dbb6",
   "metadata": {},
   "source": [
    "## 1. An influent WasteStream by concentration\n",
    "\n",
    "`set_flow_by_concentration` builds a stream from a volumetric flow and pollutant\n",
    "concentrations (mg/L) â€” how wastewater data actually arrives."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "cd4a2c10",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-07-12T11:50:37.993736Z",
     "iopub.status.busy": "2026-07-12T11:50:37.992302Z",
     "iopub.status.idle": "2026-07-12T11:50:38.035511Z",
     "shell.execute_reply": "2026-07-12T11:50:38.034523Z"
    }
   },
   "outputs": [],
   "source": [
    "inf = qs.WasteStream(\"influent\")\n",
    "inf.set_flow_by_concentration(\n",
    "    flow_tot=1000,                       # m3/hr\n",
    "    concentrations={\n",
    "        \"S_F\": 200,       # readily biodegradable COD\n",
    "        \"X_B_Subst\": 150, # slowly biodegradable substrate\n",
    "        \"S_NH4\": 40,      # ammonium N\n",
    "        \"S_PO4\": 8,       # phosphate P\n",
    "    },\n",
    "    units=(\"m3/hr\", \"mg/L\"),\n",
    ")"
   ]
  },
  {
