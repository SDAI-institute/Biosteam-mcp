     "iopub.status.idle": "2026-07-12T11:46:34.611934Z",
     "shell.execute_reply": "2026-07-12T11:46:34.610947Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "BioSTEAM 2.51.19\n"
     ]
    }
   ],
   "source": [
    "import warnings\n",
    "warnings.filterwarnings(\"ignore\")\n",
    "\n",
    "import biosteam as bst\n",
    "from thermosteam.reaction import Reaction\n",
    "\n",
    "bst.main_flowsheet.clear()\n",
    "bst.settings.set_thermo([\"Water\", \"Ethanol\", \"Glucose\", \"CO2\"])\n",
    "print(\"BioSTEAM\", bst.__version__)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "525f1179",
   "metadata": {},
   "source": [
    "## 1. Define an indicator and set characterization factors\n",
    "\n",
    "`define_impact_indicator` registers the metric; `stream.set_CF` and\n",
    "`PowerUtility.set_CF` attach per-kg / per-kWh factors (illustrative values)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "984418a3",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-07-12T11:46:34.618770Z",
     "iopub.status.busy": "2026-07-12T11:46:34.617793Z",
     "iopub.status.idle": "2026-07-12T11:46:34.630649Z",
     "shell.execute_reply": "2026-07-12T11:46:34.629107Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "feed GWP CF   : 1.2 kg CO2e/kg\n",
      "power GWP CF  : (0.45, 0.45) kg CO2e/kWh\n"
     ]
    }
   ],
   "source": [
    "GWP = \"GWP\"\n",
    "bst.settings.define_impact_indicator(GWP, \"kg*CO2e\")\n",
    "\n",
    "feed = bst.Stream(\"feed\", Glucose=100, Water=900, units=\"kmol/hr\")\n",
    "feed.set_CF(GWP, 1.20)                       # 1.20 kg CO2e per kg glucose feed (cradle-to-gate)\n",
    "bst.PowerUtility.set_CF(GWP, 0.45)           # 0.45 kg CO2e per kWh grid electricity\n",
    "print(\"feed GWP CF   :\", feed.get_CF(GWP), \"kg CO2e/kg\")\n",
    "print(\"power GWP CF  :\", bst.PowerUtility.get_CF(GWP), \"kg CO2e/kWh\")"
   ]
  },
